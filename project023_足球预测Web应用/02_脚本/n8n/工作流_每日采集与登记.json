{
  "id": "hmQuantDaily0001",
  "name": "足球预测 - 每日采集与登记",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "每日触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "// 北京时间当天。要跑别的日期就改这里，或换成 Set 节点手填。\nconst cst = new Date(Date.now() + 8 * 3600 * 1000);\nconst kickoff_date = cst.toISOString().slice(0, 10);\nreturn [{ json: { base: 'http://127.0.0.1:8765', kickoff_date } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "参数",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.base }}/api/health",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "健康检查",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('参数').first().json.base }}/api/collect",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kickoff_date: $('参数').first().json.kickoff_date }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "采集",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "等采集",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [800, 300],
      "webhookId": "b1000000-0000-4000-8000-000000000005"
    },
    {
      "parameters": {
        "url": "={{ $('参数').first().json.base }}/api/run/{{ $('采集').first().json.run_id }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "查采集进度",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-collect-err",
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "采集出错?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "errorMessage": "={{ '采集失败: ' + ($json.message || '无消息') }}"
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "中止-采集失败",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1400, 140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-collect-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "采集完成?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1400, 460]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('参数').first().json.base }}/api/predict",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kickoff_date: $('参数').first().json.kickoff_date }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "登记预测",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, 460]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "等预测",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1820, 460],
      "webhookId": "b1000000-0000-4000-8000-000000000011"
    },
    {
      "parameters": {
        "url": "={{ $('参数').first().json.base }}/api/run/{{ $('登记预测').first().json.run_id }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "查预测进度",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-predict-err",
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "预测出错?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2220, 460]
    },
    {
      "parameters": {
        "errorMessage": "={{ '登记失败: ' + ($json.message || '无消息') }}"
      },
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "中止-登记失败",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [2420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-predict-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000015",
      "name": "预测完成?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2420, 620]
    },
    {
      "parameters": {
        "url": "={{ $('参数').first().json.base }}/api/export/report",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000016",
      "name": "导出看板",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 620]
    }
  ],
  "connections": {
    "每日触发": {
      "main": [[{ "node": "参数", "type": "main", "index": 0 }]]
    },
    "参数": {
      "main": [[{ "node": "健康检查", "type": "main", "index": 0 }]]
    },
    "健康检查": {
      "main": [[{ "node": "采集", "type": "main", "index": 0 }]]
    },
    "采集": {
      "main": [[{ "node": "等采集", "type": "main", "index": 0 }]]
    },
    "等采集": {
      "main": [[{ "node": "查采集进度", "type": "main", "index": 0 }]]
    },
    "查采集进度": {
      "main": [[{ "node": "采集出错?", "type": "main", "index": 0 }]]
    },
    "采集出错?": {
      "main": [
        [{ "node": "中止-采集失败", "type": "main", "index": 0 }],
        [{ "node": "采集完成?", "type": "main", "index": 0 }]
      ]
    },
    "采集完成?": {
      "main": [
        [{ "node": "登记预测", "type": "main", "index": 0 }],
        [{ "node": "等采集", "type": "main", "index": 0 }]
      ]
    },
    "登记预测": {
      "main": [[{ "node": "等预测", "type": "main", "index": 0 }]]
    },
    "等预测": {
      "main": [[{ "node": "查预测进度", "type": "main", "index": 0 }]]
    },
    "查预测进度": {
      "main": [[{ "node": "预测出错?", "type": "main", "index": 0 }]]
    },
    "预测出错?": {
      "main": [
        [{ "node": "中止-登记失败", "type": "main", "index": 0 }],
        [{ "node": "预测完成?", "type": "main", "index": 0 }]
      ]
    },
    "预测完成?": {
      "main": [
        [{ "node": "导出看板", "type": "main", "index": 0 }],
        [{ "node": "等预测", "type": "main", "index": 0 }]
      ]
    },
    "导出看板": {
      "main": [[]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Asia/Shanghai"
  },
  "pinData": {}
}
