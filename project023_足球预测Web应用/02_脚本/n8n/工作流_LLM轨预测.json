{
  "id": "hmQuantLlm0001",
  "name": "足球预测 - LLM轨预测",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "45 9 * * *"
            }
          ]
        }
      },
      "id": "e1000000-0000-4000-8000-000000000001",
      "name": "每日触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "// 北京时间当天。要跑别的日期就改这里。\nconst cst = new Date(Date.now() + 8 * 3600 * 1000);\nconst kickoff_date = cst.toISOString().slice(0, 10);\nreturn [{ json: { base: 'http://127.0.0.1:8765', kickoff_date } }];"
      },
      "id": "e1000000-0000-4000-8000-000000000002",
      "name": "参数",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.base }}/api/health",
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000003",
      "name": "健康检查",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('参数').first().json.base }}/api/llm",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ kickoff_date: $('参数').first().json.kickoff_date }) }}",
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000004",
      "name": "LLM轨",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      },
      "id": "e1000000-0000-4000-8000-000000000005",
      "name": "等LLM",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [800, 300],
      "webhookId": "f1000000-0000-4000-8000-000000000005"
    },
    {
      "parameters": {
        "url": "={{ $('参数').first().json.base }}/api/run/{{ $('LLM轨').first().json.run_id }}",
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000006",
      "name": "查LLM进度",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-llm-err",
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000007",
      "name": "LLM出错?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'LLM轨失败: ' + ($json.message || '无消息') }}"
      },
      "id": "e1000000-0000-4000-8000-000000000008",
      "name": "中止-LLM失败",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1400, 140]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-llm-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000009",
      "name": "LLM完成?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1400, 460]
    },
    {
      "parameters": {
        "jsCode": "// 只转述工作台进度，不把 LLM 方向和量化合成「更准」。\nconst r = $input.first().json;\nconst day = $('参数').first().json.kickoff_date;\nreturn [{ json: {\n  kickoff_date: day,\n  status: r.status,\n  done: r.done ?? null,\n  total: r.total ?? null,\n  message: r.message || '',\n  提示: 'LLM 是证据方向；落盘在 fusion forward/{date}/LLM轨.md'\n} }];"
      },
      "id": "e1000000-0000-4000-8000-000000000010",
      "name": "汇总",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 460]
    }
  ],
  "connections": {
    "每日触发": {
      "main": [[{ "node": "参数", "type": "main", "index": 0 }]]
    },
    "参数": {
      "main": [[{ "node": "健康检查", "type": "main", "index": 0 }]]
    },
    "健康检查": {
      "main": [[{ "node": "LLM轨", "type": "main", "index": 0 }]]
    },
    "LLM轨": {
      "main": [[{ "node": "等LLM", "type": "main", "index": 0 }]]
    },
    "等LLM": {
      "main": [[{ "node": "查LLM进度", "type": "main", "index": 0 }]]
    },
    "查LLM进度": {
      "main": [[{ "node": "LLM出错?", "type": "main", "index": 0 }]]
    },
    "LLM出错?": {
      "main": [
        [{ "node": "中止-LLM失败", "type": "main", "index": 0 }],
        [{ "node": "LLM完成?", "type": "main", "index": 0 }]
      ]
    },
    "LLM完成?": {
      "main": [
        [{ "node": "汇总", "type": "main", "index": 0 }],
        [{ "node": "等LLM", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "Asia/Shanghai"
  },
  "pinData": {}
}
